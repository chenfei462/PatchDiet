# PatchDiet GitHub App environment template.
#
# Copy to packages/github-app/.env and fill in real values:
#   cp packages/github-app/.env.example packages/github-app/.env
#
# Never commit the populated .env file.

# ── Consumed by packages/github-app/src/server.mjs today ────────────────────

# Port the local webhook server listens on (default: 3000).
PATCHDIET_APP_PORT=3000

# HMAC secret GitHub uses to sign webhook deliveries (x-hub-signature-256).
# Required outside local development: without it the server fails closed in
# production (503) and only accepts unsigned webhooks for local development.
# Generate one with: openssl rand -hex 32
PATCHDIET_GITHUB_WEBHOOK_SECRET=

# Separate shared secret held only by the trusted customer runner and App server.
# Without it, /runner/receipts is disabled.
PATCHDIET_RUNNER_RECEIPT_SECRET=

# Bearer token for private /jobs and /runner/actions endpoints.
PATCHDIET_APP_ADMIN_TOKEN=

# Explicit local development only. Never enable in production.
PATCHDIET_ALLOW_UNSIGNED_PREVIEW=0

# Requires the opt-in contents:write App manifest. Only a requested check-run
# action can create a branch, after a matching signed verified receipt.
PATCHDIET_ENABLE_CLEANUP_BRANCH=0

# ── GitHub App credentials (installation-token exchange) ────────────────────

# Numeric GitHub App id (JWT "iss" claim) and OAuth client credentials from
# the App settings page.
PATCHDIET_GITHUB_APP_ID=
PATCHDIET_GITHUB_CLIENT_ID=
PATCHDIET_GITHUB_CLIENT_SECRET=

# Path to the PEM private key generated in the GitHub App settings
# ("Private key" section). The key never leaves your hosting platform.
PATCHDIET_GITHUB_PRIVATE_KEY_PATH=

# ── Reserved for verified mode (see docs/github-app.md) ─────────────────────

# Command the trusted runner executes for test-verified shrink reports.
PATCHDIET_DEFAULT_TEST_COMMAND=

# Comment rendering mode: "preview" (default) or "verified" once the runner
# pipeline is enabled.
PATCHDIET_COMMENT_MODE=preview
