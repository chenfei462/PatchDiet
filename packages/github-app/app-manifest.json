{
  "name": "PatchDiet (self-hosted)",
  "url": "https://patchdiet.example.com",
  "hook_attributes": {
    "active": true
  },
  "hook_url": "https://patchdiet.example.com/github/webhook",
  "redirect_url": "https://patchdiet.example.com/github/app-setup",
  "callback_urls": [
    "https://patchdiet.example.com/github/oauth/callback"
  ],
  "setup_url": "https://patchdiet.example.com/github/app-setup",
  "setup_on_update": true,
  "public": false,
  "request_oauth_on_install": false,
  "description": "PatchDiet reviews pull requests and suggests deletion-first cleanups. Self-hosted preview mode comments a diff diet preview on every pull request.",
  "default_events": [
    "pull_request"
  ],
  "default_permissions": {
    "contents": "read",
    "metadata": "read",
    "pull_requests": "read",
    "issues": "write",
    "checks": "write"
  }
}
