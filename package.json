{
  "name": "patchdiet",
  "version": "0.2.0",
  "description": "Shrink AI-generated pull requests into smaller reviewable patches.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/chenfei462/PatchDiet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenfei462/PatchDiet.git"
  },
  "bugs": {
    "url": "https://github.com/chenfei462/PatchDiet/issues"
  },
  "bin": {
    "patchdiet": "dist/packages/cli/src/index.js"
  },
  "files": [
    "dist/packages/cli",
    "dist/packages/core",
    "dist/packages/report",
    "dist/packages/intent",
    "dist/packages/evidence",
    "dist/packages/scope",
    "README.md",
    "LICENSE",
    "packages/action/index.mjs",
    "packages/action/dist",
    "dist/packages/parsers",
    "dist/packages/knowledge"
  ],
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:action",
    "build:action": "esbuild packages/action/index.mjs --bundle --platform=node --target=node20 --format=esm --banner:js=\"import { createRequire as patchdietActionCreateRequire } from 'node:module'; const require = patchdietActionCreateRequire(import.meta.url);\" --outfile=packages/action/dist/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "node scripts/serve-demo.mjs",
    "bench:examples": "node scripts/run-example-benchmarks.mjs",
    "bench:cli-v02": "node benchmarks/run-benchmark.mjs",
    "pro:readiness": "node scripts/generate-pro-readiness.mjs",
    "github-app:dev": "node scripts/github-app-smoke.mjs",
    "prepublishOnly": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "better-sqlite3": "12.9.0",
    "commander": "^14.0.2",
    "yaml": "^2.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.1",
    "esbuild": "^0.27.7",
    "gsap": "^3.15.0",
    "parse5": "^8.0.1",
    "three": "^0.186.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "ai",
    "diff",
    "git",
    "pull-request",
    "cli",
    "patch"
  ]
}
