{
  "name": "patchdiet",
  "version": "0.1.0",
  "description": "Shrink AI-generated pull requests into smaller reviewable patches.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/chenfei462/PatchDiet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenfei462/PatchDiet.git"
  },
  "bugs": {
    "url": "https://github.com/chenfei462/PatchDiet/issues"
  },
  "bin": {
    "patchdiet": "dist/packages/cli/src/index.js"
  },
  "files": [
    "dist/packages/cli",
    "dist/packages/core",
    "dist/packages/report",
    "README.md",
    "LICENSE",
    "packages/action/index.mjs"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "ai",
    "diff",
    "git",
    "pull-request",
    "cli",
    "patch"
  ]
}
